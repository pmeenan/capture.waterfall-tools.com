{
  "name": "capture-waterfall-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Browser waterfall capture: run a page-load test on your own hardware and view it in waterfall-tools.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "site",
    "extension",
    "helper"
  ],
  "scripts": {
    "dev": "vite --config vite.config.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.js",
    "licenses": "node scripts/check-licenses.js",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run licenses",
    "deploy": "node scripts/deploy.js",
    "deploy:dry-run": "node scripts/deploy.js --dry-run"
  }
}
