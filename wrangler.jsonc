{
  // Static assets only: no Worker script, no bindings, no backend (D-001).
  // Deployed by the project owner with "npm run deploy" (D-025).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capture-waterfall-tools",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/site"
  },
  // The production origin. A custom domain makes Cloudflare create the DNS record and the
  // certificate on deploy; waterfall-tools.com is a zone on the same account.
  "routes": [
    { "pattern": "capture.waterfall-tools.com", "custom_domain": true }
  ]
}
