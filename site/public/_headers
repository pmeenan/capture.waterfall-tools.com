# Response headers for the capture site (Cloudflare static assets format).
# The capture origin is the trust anchor for the extension and the helper
# (D-018, D-022), so this policy is a security control: loosen it deliberately.
#   script-src 'self'   no inline or third-party script (D-010)
#   worker-src blob:    the worker-backed clock is created from a blob (RE-015)
#   connect-src         'self', plus the local helper on loopback (D-022). The helper checks
#                       Origin and the pairing secret itself; this only lets the page reach it.
#   frame-src           the production viewer only (D-020, architecture §3.11). A local viewer is
#                       added by scripts/preview.js --viewer, never here.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ws://127.0.0.1:*; worker-src blob:; frame-src https://waterfall-tools.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/assets/*
  Cache-Control: public, max-age=31536000, immutable
